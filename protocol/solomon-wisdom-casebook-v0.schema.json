{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nsrl.local/protocol/solomon-wisdom-casebook-v0.schema.json",
  "title": "Frozen public Solomon wisdom casebook",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "analysis_role", "ceremony_id", "frozen_before_lane_generation",
    "minimum_cases_per_dimension", "underlying_model", "integrity_policy", "cases"
  ],
  "properties": {
    "schema": {"const": "nsrl.solomon_wisdom_casebook.v0"},
    "analysis_role": {"enum": ["frozen_same_model_comparison", "self_test_only"]},
    "ceremony_id": {"type": "string", "minLength": 1},
    "frozen_before_lane_generation": {"const": true},
    "minimum_cases_per_dimension": {"type": "integer", "minimum": 1},
    "underlying_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "artifact"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "integrity_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_oracle_target_lookup", "no_hidden_memory", "no_retrieval_target_leakage",
        "gold_commitment_algorithm"
      ],
      "properties": {
        "no_oracle_target_lookup": {"const": true},
        "no_hidden_memory": {"const": true},
        "no_retrieval_target_leakage": {"const": true},
        "gold_commitment_algorithm": {"const": "sha256-canonical-json-v0"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"analysis_role": {"const": "frozen_same_model_comparison"}}},
      "then": {"properties": {"minimum_cases_per_dimension": {"minimum": 72}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dimension": {
      "enum": [
        "source_grounded_correctness", "calibration", "hard_negative_rejection",
        "contradiction_detection", "decision_regret", "appropriate_abstention",
        "cross_modal_agreement", "unfamiliar_source_transfer"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id", "dimension", "source_family", "unfamiliar_source", "evidence",
        "decision_ids", "gold_commitment_sha256"
      ],
      "properties": {
        "episode_id": {"type": "string", "minLength": 1},
        "dimension": {"$ref": "#/$defs/dimension"},
        "source_family": {"type": "string", "minLength": 1},
        "unfamiliar_source": {"type": "boolean"},
        "evidence": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "decision_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "gold_commitment_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
