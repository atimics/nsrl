{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nsrl.local/protocol/judgment-record-v1.schema.json",
  "title": "NSRL evidence-bound judgment record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "judgment_id",
    "sequence_index",
    "context",
    "candidate_actions",
    "selected",
    "falsifier",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "nsrl.judgment_record.v1"},
    "judgment_id": {"type": "string", "minLength": 1},
    "sequence_index": {"type": "integer", "minimum": 1},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_family",
        "passage_ordinal",
        "history_available_before_action",
        "history_guard_open"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_family": {"enum": ["federal_register", "rfc", "science"]},
        "passage_ordinal": {"type": "integer", "minimum": 0, "maximum": 3},
        "history_available_before_action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "completed_source_panels",
            "cumulative_signed_regret_q32",
            "unsafe_source_panels",
            "unsafe_e_value_numerator",
            "unsafe_e_value_denominator"
          ],
          "properties": {
            "completed_source_panels": {"type": "integer", "minimum": 0},
            "cumulative_signed_regret_q32": {"type": "string", "pattern": "^-?[0-9]+$"},
            "unsafe_source_panels": {"type": "integer", "minimum": 0},
            "unsafe_e_value_numerator": {"type": "string", "pattern": "^[0-9]+$"},
            "unsafe_e_value_denominator": {"type": "string", "pattern": "^[1-9][0-9]*$"}
          }
        },
        "history_guard_open": {"type": "boolean"}
      }
    },
    "candidate_actions": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/candidateAction"}
    },
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action_id", "rationale"],
      "properties": {
        "kind": {"enum": ["action", "abstention"]},
        "action_id": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "realized_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opened_after_selection", "signed_regret_q32", "positive_regret_q32", "unsafe"],
      "properties": {
        "opened_after_selection": {"const": true},
        "signed_regret_q32": {"type": "string", "pattern": "^-?[0-9]+$"},
        "positive_regret_q32": {"type": "string", "pattern": "^[0-9]+$"},
        "unsafe": {"type": "boolean"}
      }
    },
    "falsifier": {"$ref": "#/$defs/falsifier"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provenance"}
    }
  },
  "$defs": {
    "candidateAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "faculty_id",
        "action_family",
        "eligible",
        "evidence",
        "predicted_benefit_q32",
        "possible_harm_q32",
        "uncertainty_envelope_q32",
        "intervention_cost",
        "reversibility",
        "falsifier",
        "provenance",
        "symbolic_feature"
      ],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "faculty_id": {"type": "string", "minLength": 1},
        "action_family": {
          "enum": [
            "federal_register_exchange",
            "rfc_exchange",
            "science_exchange",
            "occult_correspondence",
            "abstention"
          ]
        },
        "eligible": {"type": "boolean"},
        "control_mask": {"type": "integer", "minimum": 0, "maximum": 63},
        "candidate_mask": {"type": "integer", "minimum": 0, "maximum": 63},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strength_q32", "conditions", "provenance_sha256"],
          "properties": {
            "strength_q32": {"type": "string", "pattern": "^-?[0-9]+$"},
            "conditions": {"type": "array", "items": {"type": "string"}},
            "provenance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "predicted_benefit_q32": {"type": "string", "pattern": "^-?[0-9]+$"},
        "possible_harm_q32": {"type": "string", "pattern": "^[0-9]+$"},
        "uncertainty_envelope_q32": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lower", "upper", "coverage", "unit"],
          "properties": {
            "lower": {"type": "string", "pattern": "^-?[0-9]+$"},
            "upper": {"type": "string", "pattern": "^-?[0-9]+$"},
            "coverage": {"const": "19/20 marginal source-panel"},
            "unit": {"const": "candidate_minus_control_q32"}
          }
        },
        "intervention_cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coordinate_writes", "objective_penalty_q32"],
          "properties": {
            "coordinate_writes": {"type": "integer", "minimum": 0},
            "objective_penalty_q32": {"type": "string", "pattern": "^[0-9]+$"}
          }
        },
        "reversibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "inverse_coordinate_writes", "condition"],
          "properties": {
            "class": {"enum": ["exact", "not_applicable"]},
            "inverse_coordinate_writes": {"type": "integer", "minimum": 0},
            "condition": {"type": "string", "minLength": 1}
          }
        },
        "falsifier": {"$ref": "#/$defs/falsifier"},
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/provenance"}
        },
        "symbolic_feature": {"type": "boolean"}
      }
    },
    "falsifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "status_if_triggered"],
      "properties": {
        "condition": {"type": "string", "minLength": 1},
        "status_if_triggered": {"enum": ["falsified", "inconclusive"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string", "minLength": 1}
      }
    }
  }
}
