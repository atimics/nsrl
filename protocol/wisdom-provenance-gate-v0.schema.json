{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nsrl.local/protocol/wisdom-provenance-gate-v0.schema.json",
  "title": "Wisdom evaluation provenance and leakage gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "model_artifact_sha256", "source_hashes", "trace_hashes", "gates"],
  "properties": {
    "schema": {"const": "nsrl.wisdom_provenance_gate.v0"},
    "ok": {"const": true},
    "model_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_hashes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "trace_hashes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_oracle_target_lookup", "no_hidden_memory", "no_retrieval_target_leakage",
        "gold_sealed_until_both_predictions"
      ],
      "properties": {
        "no_oracle_target_lookup": {"const": true},
        "no_hidden_memory": {"const": true},
        "no_retrieval_target_leakage": {"const": true},
        "gold_sealed_until_both_predictions": {"const": true}
      }
    }
  }
}
