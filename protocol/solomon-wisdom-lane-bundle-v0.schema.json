{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nsrl.local/protocol/solomon-wisdom-lane-bundle-v0.schema.json",
  "title": "Sealed Solomon wisdom evaluation lane",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "lane", "ceremony_id", "casebook_sha256", "underlying_model_sha256",
    "generated_without_opened_gold", "episodes"
  ],
  "properties": {
    "schema": {"const": "nsrl.solomon_wisdom_lane_bundle.v0"},
    "lane": {"enum": ["solo", "council"]},
    "ceremony_id": {"type": "string", "minLength": 1},
    "casebook_sha256": {"$ref": "#/$defs/sha256"},
    "underlying_model_sha256": {"$ref": "#/$defs/sha256"},
    "generated_without_opened_gold": {"const": true},
    "episodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/episode"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prediction_label", "confidence_milli", "abstained", "decision_id"],
      "properties": {
        "prediction_label": {"type": "boolean"},
        "confidence_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "abstained": {"type": "boolean"},
        "decision_id": {"type": "string", "minLength": 1}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "artifact_sha256", "receipt_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id", "prediction", "trace"],
      "properties": {
        "episode_id": {"type": "string", "minLength": 1},
        "prediction": {"$ref": "#/$defs/prediction"},
        "trace": {"$ref": "#/$defs/artifact"},
        "request": {"$ref": "#/$defs/artifact"},
        "receipt": {"$ref": "#/$defs/receipt"}
      },
      "allOf": [
        {
          "if": {"required": ["receipt"]},
          "then": {"required": ["request"]}
        }
      ]
    }
  }
}
